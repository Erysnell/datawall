# ── Unattributed-traffic diagnostic ─────────────────────────

# VPN / tunnel interfaces: traffic crossing one is counted twice system-wide,
# once as tunnel payload and once encapsulated on the physical underlay.
TUNNEL_PREFIXES = ('tun', 'tap', 'wg', 'ppp', 'nordlynx', 'proton', 'zt')
# IPv4 header + TCP header with typical options, per segment.
TCP_HEADER_BYTES = 52


def _is_tunnel(name: str) -> bool:
    return name.startswith(TUNNEL_PREFIXES)


def _read_proc_counters(paths: tuple = ('/proc/net/snmp', '/proc/net/netstat')) -> dict:
    """Protocol counters from /proc/net/snmp and /proc/net/netstat.

    System-wide and all-interface: with a VPN up these count both passes of
    the same payload, so they are only good for protocol *mix*, not volume.
    """
    wanted = {
        'Tcp': ('InSegs', 'OutSegs'),
        'Udp': ('InDatagrams', 'OutDatagrams'),
        'IpExt': ('InOctets', 'OutOctets'),
    }
    out = {}
    for path in paths:
        try:
            lines = Path(path).read_text().splitlines()
        except OSError:
            continue
        headers = {}
        for line in lines:
            proto, sep, rest = line.partition(':')
            if not sep or proto not in wanted:
                continue
            fields = rest.split()
            if proto not in headers:
                headers[proto] = fields  # first occurrence names the columns
                continue
            for field in wanted[proto]:
                if field in headers[proto]:
                    idx = headers[proto].index(field)
                    if idx < len(fields):
                        try:
                            out[f'{proto}.{field}'] = int(fields[idx])
                        except ValueError:
                            pass
            del headers[proto]
    return out


def _socket_ownership() -> tuple:
    """(sockets with no owning PID, total sockets) as `ss` sees them.

    Without privileges the kernel hides other users' socket owners, so their
    traffic can never be attributed to a program.
    """
    try:
        r = subprocess.run(['ss', '-tpn'], capture_output=True, text=True, timeout=5)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return 0, 0
    total = unowned = 0
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) < 5 or parts[0] in ('State', 'Netid'):
            continue
        total += 1
        if 'users:((' not in line:
            unowned += 1
    return unowned, total


def show_explain(window: float = 4.0) -> None:
    """Measure where the unattributed bytes actually come from, right now."""
    if not _rich_ok:
        print("ERROR: 'rich' is required. Install with: pip install rich")
        sys.exit(1)

    console = _RichConsole()
    iface = get_active_interface()
    if not iface:
        console.print("[red]No active network interface found.[/red]")
        return

    try:
        all_counters = psutil.net_io_counters(pernic=True)
    except Exception:
        all_counters = {}
    route_iface = _default_route_iface()
    tunnels = [n for n in all_counters
               if _is_tunnel(n) and (all_counters[n].bytes_sent or all_counters[n].bytes_recv)]

    # ── sample ──
    console.print(f"\n  Sampling [cyan]{iface}[/cyan] for {window:.0f}s...")
    before_ss = {(pid, fd): (a, r) for pid, fd, _n, a, r in sample_sockdiag()}
    c0 = get_interface_counters(iface)
    p0 = _read_proc_counters()
    time.sleep(window)
    p1 = _read_proc_counters()
    c1 = get_interface_counters(iface)
    after_ss = sample_sockdiag()

    if c0 is None or c1 is None:
        console.print(f"[red]Interface {iface} disappeared while sampling.[/red]")
        return

    iface_tx = max(0, c1[0] - c0[0])
    iface_rx = max(0, c1[1] - c0[1])
    iface_total = iface_tx + iface_rx

    tracked_tx = tracked_rx = 0
    for pid, fd, _name, acked, recv in after_ss:
        prev = before_ss.get((pid, fd))
        if prev is None:
            # Not present at the start, so this socket opened during the window
            # and its whole lifetime counter falls inside it. Skipping these
            # made short-window attribution look far worse than it is.
            tracked_tx += acked
            tracked_rx += recv
        elif acked >= prev[0] and recv >= prev[1]:
            tracked_tx += acked - prev[0]
            tracked_rx += recv - prev[1]
    tracked_tx = min(tracked_tx, iface_tx)
    tracked_rx = min(tracked_rx, iface_rx)
    tracked_total = tracked_tx + tracked_rx
    unattr_total = max(0, iface_total - tracked_total)

    def delta(key):
        a, b = p0.get(key), p1.get(key)
        return max(0, b - a) if isinstance(a, int) and isinstance(b, int) else None

    tcp_segs = delta('Tcp.InSegs'), delta('Tcp.OutSegs')
    udp_dgrams = delta('Udp.InDatagrams'), delta('Udp.OutDatagrams')
    seg_count = sum(s for s in tcp_segs if s) or 0
    dgram_count = sum(d for d in udp_dgrams if d) or 0
    hdr_estimate = seg_count * TCP_HEADER_BYTES

    def pct(n):
        return f"{n / iface_total * 100:5.1f}%" if iface_total > 0 else "    —"

    # ── measured attribution ──
    t1 = _RichTable(box=_rich_box.SIMPLE, header_style="bold magenta", pad_edge=False)
    t1.add_column("Measured over the sample")
    t1.add_column("Sent", justify="right", style="yellow")
    t1.add_column("Received", justify="right", style="green")
    t1.add_column("Total", justify="right", style="cyan")
    t1.add_column("Share", justify="right")
    t1.add_row(f"Interface {iface}", format_bytes(iface_tx), format_bytes(iface_rx),
               format_bytes(iface_total), pct(iface_total))
    t1.add_row("Attributed to TCP sockets", format_bytes(tracked_tx), format_bytes(tracked_rx),
               format_bytes(tracked_total), pct(tracked_total))
    t1.add_row(f"[bold]{UNATTRIBUTED}[/bold]", "", "",
               f"[bold]{format_bytes(unattr_total)}[/bold]", f"[bold]{pct(unattr_total)}[/bold]")
    console.print(_RichPanel(t1, title=_RichText("Where the bytes went", style="bold cyan"),
                             border_style="cyan", padding=(1, 2)))

    # ── protocol mix ──
    t2 = _RichTable(box=_rich_box.SIMPLE, header_style="bold magenta", pad_edge=False)
    t2.add_column("Protocol mix (system-wide)")
    t2.add_column("Rate", justify="right")
    t2.add_column("Note", style="dim")
    t2.add_row("TCP segments", f"{seg_count / window:,.0f}/s", "tracked per process")
    t2.add_row("UDP datagrams", f"{dgram_count / window:,.0f}/s",
               "invisible to per-process tracking")
    t2.add_row("TCP+IP headers (est.)", format_bytes(hdr_estimate),
               f"{seg_count:,} segs x {TCP_HEADER_BYTES} B, payload-only counters miss these")
    console.print(_RichPanel(t2, title=_RichText("Protocol mix", style="bold cyan"),
                             border_style="cyan", padding=(1, 2)))

    # ── ranked causes, from what was actually observed ──
    findings = []
    if tunnels and not _is_tunnel(iface):
        findings.append(("red", f"Monitoring the physical interface {iface} while tunnel(s) "
                                f"{', '.join(tunnels)} carry traffic. `ss` reports tunnel "
                                f"payload but {iface} counts it encrypted and encapsulated, so "
                                f"the whole difference is unattributable. Set "
                                f'\'{{"interface": "{tunnels[0]}"}}\' in config.json, or accept '
                                f"that the overhead lands in {UNATTRIBUTED}."))
    elif _is_tunnel(iface):
        findings.append(("green", f"{iface} is a tunnel, so socket payload and interface bytes "
                                  f"line up. Tunnel overhead on the physical link is not counted "
                                  f"here, so this undercounts what the carrier bills."))
    if route_iface and route_iface != iface:
        findings.append(("yellow", f"The default route is on {route_iface}, not the monitored "
                                   f"{iface}. Traffic leaving via {route_iface} is missed entirely."))
    if dgram_count > seg_count:
        findings.append(("red", f"UDP ({dgram_count / window:,.0f} datagrams/s) outpaces TCP "
                                f"({seg_count / window:,.0f} segments/s). QUIC/HTTP3 video, DNS "
                                f"and video calls are all UDP, and `ss -tpin` is TCP-only."))
    elif dgram_count:
        findings.append(("yellow", f"UDP is running at {dgram_count / window:,.0f} datagrams/s "
                                   f"and is never attributed to a program."))
    # Segment counts are system-wide while iface_total is one interface, so
    # compare headers against TCP wire bytes and only when the ratio is sane.
    tcp_wire_est = tracked_total + hdr_estimate
    if tracked_total > 0 and tcp_wire_est > 0:
        hdr_share = hdr_estimate / tcp_wire_est
        if 0.03 < hdr_share < 0.6:
            findings.append(("yellow", f"TCP/IP headers are roughly {hdr_share * 100:.0f}% of TCP "
                                       f"wire bytes. Socket counters report payload only, so that "
                                       f"share can never be attributed to a program."))
    unowned, total_socks = _socket_ownership()
    if unowned:
        findings.append(("yellow", f"{unowned} of {total_socks} TCP sockets have no visible owner "
                                   f"{'(running unprivileged)' if os.geteuid() else ''}. Traffic "
                                   f"from other users' and root's processes cannot be attributed."))
    if not findings:
        findings.append(("green", "Nothing structural found. The residue is most likely "
                                  "short-lived sockets opening and closing between samples, "
                                  "plus retransmissions and ARP/ICMP."))

    if iface_total < 100_000:
        console.print(
            f"  [yellow]Only {format_bytes(iface_total)} crossed {iface} during the sample — too "
            f"little to conclude much.[/yellow]\n  [dim]Re-run with a longer window while "
            f"something is downloading, e.g.[/dim] datawall explain 30",
            highlight=False)
        console.print()

    severity = {"red": 0, "yellow": 1, "green": 2}
    findings.sort(key=lambda f: severity[f[0]])

    console.print(_RichText("  Likely causes, ranked", style="bold cyan"))
    # a table gives the hanging indent that a plain wrapped print does not
    t3 = _RichTable(box=None, show_header=False, pad_edge=False, padding=(0, 1))
    t3.add_column(width=1, no_wrap=True)
    t3.add_column(overflow="fold")
    for color, text in findings:
        mark = {"red": "!", "yellow": "~", "green": "+"}[color]
        t3.add_row(f"[{color}]{mark}[/{color}]", text)
    console.print(_RichPadding(t3, (1, 2)))


# ── CLI ─────────────────────────────────────────────────────

def main() -> None:
    if psutil is None:
        print("ERROR: 'psutil' is required. Install with: pip install psutil")
        sys.exit(1)

    p = argparse.ArgumentParser(
        description="datawall — Network data usage tracker per program",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
commands:
  datawall              show daily usage report (default)
  datawall start        start background daemon (fork)
  datawall run          run daemon in foreground (for systemd)
  datawall stop         stop background daemon
  datawall restart      restart the daemon
  datawall status       check if daemon is running
  datawall reset        reset today's accumulated data
  datawall watch        real-time bandwidth monitor (htop-like)
  datawall days N       aggregated report for last N days
  datawall limit        show current daily limit and usage
  datawall limit SIZE   set daily limit (e.g. 5GB, 500MB)
  datawall limit off    remove daily limit
  datawall connections  show active TCP connections per program
  datawall explain      diagnose where "unattributed" traffic comes from
  datawall explain N    same, sampling for N seconds (default 4)
        """
    )
    p.add_argument(
        'command', nargs='?', default='report',
        choices=['report', 'start', 'run', 'daemon', 'stop', 'restart', 'status', 'reset',
                 'watch', 'days', 'limit', 'connections', 'explain']
    )
    p.add_argument('arg1', nargs='?', type=str, default=None,
                   help=argparse.SUPPRESS)
    p.add_argument('--version', action='version', version=f'datawall {VERSION}')

    args = p.parse_args()

    if args.command == 'start':
        daemon_start()
    elif args.command in ('run', 'daemon'):
        daemon_run()
    elif args.command == 'stop':
        daemon_stop()
    elif args.command == 'restart':
        daemon_stop()
        time.sleep(1)
        daemon_start()
    elif args.command == 'status':
        print("datawall: daemon is", "running" if daemon_status() else "stopped")
    elif args.command == 'reset':
        DataStore().reset_today()
        print("datawall: today's data has been reset")
    elif args.command == 'watch':
        watch_mode()
    elif args.command == 'days':
        try:
            n = int(args.arg1) if args.arg1 else None
        except ValueError:
            n = None
        if n is None or n < 1:
            print("datawall: usage: datawall days N")
            sys.exit(1)
        show_report(days=n)
    elif args.command == 'limit':
        limit_mode(args.arg1)
    elif args.command == 'connections':
        show_connections()
    elif args.command == 'explain':
        try:
            w = float(args.arg1) if args.arg1 else 4.0
        except ValueError:
            print("datawall: usage: datawall explain [SECONDS]")
            sys.exit(1)
        show_explain(max(1.0, min(300.0, w)))
    else:
        show_report()


if __name__ == '__main__':
    main()
