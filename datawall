VERSION = '1.2.0'

DATA_DIR = Path.home() / '.datawall'
STORE_PATH = DATA_DIR / 'store.json'
PID_PATH = DATA_DIR / 'daemon.pid'
LOG_PATH = DATA_DIR / 'daemon.log'
CONFIG_PATH = DATA_DIR / 'config.json'
# Volatile daemon state (current speed, monitored interface). Kept out of
# store.json so the history file is only written when bytes actually move.
LIVE_PATH = DATA_DIR / 'live.json'
SAMPLE_INTERVAL = 5
# Bucket for interface bytes that no visible TCP socket could explain.
# `datawall explain` breaks down where it comes from.
UNATTRIBUTED = 'unattributed'
# Runtime bookkeeping that used to be persisted inside each day.
_VOLATILE_DAY_KEYS = ('last_tx', 'last_rx', 'last_time', 'speed_sent', 'speed_recv')
DEFAULT_RETENTION_DAYS = 90
# Percentages of the daily limit that trigger a desktop notification, once
# per threshold per day.
DEFAULT_NOTIFY_THRESHOLDS = (80, 100)
# Re-check which interface carries the default route once a minute, so a VPN
# going up or down does not leave the daemon reading a dead counter.
IFACE_RECHECK_EVERY = 12


def format_bytes(n: float) -> str:
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if abs(n) < 1024.0:
            return f"{n:.1f} {unit}"
        n /= 1024.0
    return f"{n:.1f} PB"


def format_speed(n: float) -> str:
    return format_bytes(n) + '/s'


def parse_bytes(s: str) -> int:
    s = s.strip().lower()
    if s in ('off', 'none', '0'):
        return 0
    units = {'tb': 1024**4, 'gb': 1024**3, 'mb': 1024**2, 'kb': 1024, 'b': 1}
    for unit, mult in units.items():
        if s.endswith(unit):
            rest = s[:-len(unit)].strip()
            try:
                return int(float(rest) * mult)
            except ValueError:
                raise ValueError(f"invalid size: '{s}' (e.g. 5GB, 500MB, off)")
    try:
        return int(s)
    except ValueError:
        raise ValueError(f"invalid size: '{s}' (e.g. 5GB, 500MB, off)")


def log(msg: str) -> None:
    try:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        with open(LOG_PATH, 'a') as f:
            f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")
    except OSError:
        pass


# ── Network helpers ──────────────────────────────────────────

# Container, bridge and loopback interfaces never carry the real uplink.
VIRTUAL_PREFIXES = ('lo', 'docker', 'br-', 'virbr', 'veth', 'vmnet', 'vboxnet')


def _is_virtual(name: str) -> bool:
    return name.startswith(VIRTUAL_PREFIXES)


def _default_route_iface(path: str = '/proc/net/route') -> Optional[str]:
    """Interface holding the IPv4 default route, per /proc/net/route.

    The path is a parameter so the parsing can be tested against a fixture.
    """
    try:
        with open(path) as f:
            next(f)  # skip header
            for line in f:
                parts = line.split()
                if len(parts) >= 2 and parts[1] == '00000000':
                    return parts[0]
    except (OSError, StopIteration):
        pass
    return None


def get_active_interface() -> Optional[str]:
    """Pick the interface carrying real traffic.

    Preference order: explicit config override, then the default-route
    interface, then any non-virtual interface with traffic, then any
    non-virtual interface that is up. Picking by dict order alone used to
    land on whichever NIC psutil happened to list first.
    """
    try:
        counters = psutil.net_io_counters(pernic=True)
    except Exception as e:
        log(f"get_active_interface counters error: {e}")
        counters = {}
    try:
        stats = psutil.net_if_stats()
    except Exception as e:
        log(f"get_active_interface stats error: {e}")
        stats = {}

    override = Config().get_interface()
    if override:
        if override in counters or override in stats:
            return override
        log(f"Configured interface '{override}' not found, auto-detecting")

    route_iface = _default_route_iface()
    if route_iface and (route_iface in counters or route_iface in stats):
        return route_iface

    for name in counters:
        if not _is_virtual(name) and (counters[name].bytes_sent > 0 or counters[name].bytes_recv > 0):
            return name
    for name in stats:
        if not _is_virtual(name) and stats[name].isup:
            return name
    log(f"Interfaces available: {list(counters.keys())}")
    log(f"Interfaces up: {[k for k, v in stats.items() if v.isup]}")
    return None


def get_interface_counters(iface: str) -> Optional[tuple]:
    """Return (bytes_sent, bytes_recv), or None if the interface is gone.

    None rather than (0, 0): a zero baseline stored on a transient failure
    gets read back next sample as a multi-gigabyte delta.
    """
    try:
        counters = psutil.net_io_counters(pernic=True)
        if iface in counters:
            c = counters[iface]
            return c.bytes_sent, c.bytes_recv
    except Exception as e:
        log(f"get_interface_counters error: {e}")
    return None


def get_current_speed(iface: str) -> tuple:
    c1 = get_interface_counters(iface)
    time.sleep(1)
    c2 = get_interface_counters(iface)
    if c1 is None or c2 is None:
        return 0.0, 0.0
    return max(0.0, float(c2[0] - c1[0])), max(0.0, float(c2[1] - c1[1]))


def get_process_connections() -> dict:
    conns_by_pid = {}
    try:
        for conn in psutil.net_connections():
            pid = conn.pid
            if pid and pid > 0 and conn.status != 'LISTEN':
                conns_by_pid[pid] = conns_by_pid.get(pid, 0) + 1
    except Exception:
        return {}
    result = {}
    for pid, count in conns_by_pid.items():
        try:
            proc = psutil.Process(pid)
            result[str(pid)] = {'name': proc.name(), 'connections': count}
        except Exception:
            pass
    return result


def parse_ss_output(output: str, include_remote: bool = False) -> list:
    sockets = []
    current = {}
    for line in output.splitlines():
        if not line.strip():
            continue
        if not line[0].isspace():
            parts = line.split()
            if len(parts) >= 5:
                local = parts[3]
                remote = parts[4]
                if local.startswith('127.') or local.startswith('[::1]'):
                    if remote.startswith('127.') or remote.startswith('[::1]'):
                        current = {}
                        continue
                if include_remote:
                    current['remote'] = remote
            m = re.search(r'"([^"]+)",pid=(\d+),fd=(\d+)', line)
            if m:
                current['name'] = m.group(1)
                current['pid'] = int(m.group(2))
                current['fd'] = int(m.group(3))
            else:
                current = {}
        else:
            if current and 'name' in current:
                if include_remote and 'remote' not in current:
                    continue
                acked = recv = None
                ma = re.search(r'bytes_acked:(\d+)', line)
                mr = re.search(r'bytes_received:(\d+)', line)
                if ma:
                    acked = int(ma.group(1))
                if mr:
                    recv = int(mr.group(1))
                if acked is not None and recv is not None:
                    if include_remote:
                        sockets.append((current['pid'], current['fd'], current['name'], current['remote'], acked, recv))
                    else:
                        sockets.append((current['pid'], current['fd'], current['name'], acked, recv))
    return sockets


def sample_sockdiag(include_remote: bool = False) -> list:
    try:
        r = subprocess.run(['ss', '-tpin'], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            return parse_ss_output(r.stdout, include_remote=include_remote)
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        pass
    return []


def sample_connections() -> list:
    return sample_sockdiag(include_remote=True)


def ss_available() -> bool:
    try:
        subprocess.run(['ss', '-V'], capture_output=True, timeout=3)
        return True
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False


# ── Data store ──────────────────────────────────────────────

def _migrate(data: dict) -> dict:
    """Bring an on-disk store up to the current schema, in place.

    Idempotent: runs on every load, including the daemon's reloads.
    """
    days = data.setdefault('days', {})
    for day in days.values():
        if not isinstance(day, dict):
            continue
        # 'other' was renamed to make the bucket self-describing
        procs = day.get('processes')
        if isinstance(procs, dict) and 'other' in procs:
            old = procs.pop('other')
            dst = procs.setdefault(UNATTRIBUTED, {'sent': 0, 'recv': 0})
            dst['sent'] += old.get('sent', 0)
            dst['recv'] += old.get('recv', 0)
        # counter baselines and speeds are runtime state, not history
        for k in _VOLATILE_DAY_KEYS:
            day.pop(k, None)
    return data


def write_live_state(iface: Optional[str], speed_sent: float, speed_recv: float) -> None:
    """Publish the daemon's current speed for readers (report, status)."""
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    tmp = LIVE_PATH.with_suffix('.tmp')
    try:
        tmp.write_text(json.dumps({
            'iface': iface,
            'speed_sent': round(speed_sent, 1),
            'speed_recv': round(speed_recv, 1),
            'time': time.time(),
        }))
        tmp.replace(LIVE_PATH)
    except OSError as e:
        log(f"Live state write error: {e}")


def read_live_state(max_age: float) -> Optional[dict]:
    """The daemon's last published speed, or None if missing or stale."""
    try:
        d = json.loads(LIVE_PATH.read_text())
    except (json.JSONDecodeError, OSError):
        return None
    if not isinstance(d, dict):
        return None
    ts = d.get('time')
    if not isinstance(ts, (int, float)) or time.time() - ts > max_age:
        return None
    if not all(isinstance(d.get(k), (int, float)) for k in ('speed_sent', 'speed_recv')):
        return None
    return d


class DataStore:
    def __init__(self):
        self.path = STORE_PATH
        # read the mtime BEFORE the contents: a write landing in between then
        # looks newer than us and triggers a harmless reload, whereas the
        # reverse order would silently miss it
        self._mtime = self._disk_mtime()
        self.data = self._load()
        self._saved = None  # last payload written, for save() short-circuit

    def _disk_mtime(self) -> Optional[int]:
        try:
            return self.path.stat().st_mtime_ns
        except OSError:
            return None

    def reload_if_changed(self) -> bool:
        """Re-read the store if another process wrote it (e.g. `datawall reset`).

        The daemon keeps one DataStore for its whole lifetime. Without this it
        holds a stale in-memory copy and writes the reset day straight back.
        """
        current = self._disk_mtime()
        if current != self._mtime:
            self._mtime = current
            self.data = self._load()
            return True
        return False

    def _load(self) -> dict:
        if self.path.exists():
            try:
                return _migrate(json.loads(self.path.read_text()))
            except (json.JSONDecodeError, OSError) as e:
                log(f"Corrupted store: {e}")
        return {'days': {}}

    def prune(self, keep_days: int) -> int:
        """Drop days older than the retention window. Returns how many went."""
        if keep_days < 1:
            return 0
        cutoff = (date.today() - timedelta(days=keep_days - 1)).isoformat()
        stale = [d for d in self.data['days'] if d < cutoff]
        for d in stale:
            del self.data['days'][d]
        return len(stale)

    def save(self) -> None:
        """Write the store, skipping the write when nothing changed.

        The daemon saves every 5s forever; now that volatile state lives in
        live.json, an idle link produces identical content and no disk write.
        """
        try:
            payload = json.dumps(self.data, indent=2)
        except (TypeError, ValueError) as e:
            log(f"Serialize error: {e}")
            return
        if payload == self._saved:
            return
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix('.tmp')
        try:
            tmp.write_text(payload)
            tmp.replace(self.path)
            self._saved = payload
            self._mtime = self._disk_mtime()
        except OSError as e:
            log(f"Save error: {e}")

    def get_today(self) -> dict:
        today = date.today().isoformat()
        if today not in self.data['days']:
            self.data['days'][today] = {
                'total_sent': 0, 'total_recv': 0,
                'processes': {},
            }
        return self.data['days'][today]

    def reset_today(self) -> None:
        self.data['days'].pop(date.today().isoformat(), None)
        self.save()


# ── Config ──────────────────────────────────────────────────

class Config:
    def __init__(self):
        self.path = CONFIG_PATH
        self.data = self._load()

    def _load(self) -> dict:
        if self.path.exists():
            try:
                return json.loads(self.path.read_text())
            except (json.JSONDecodeError, OSError):
                pass
        return {}

    def save(self) -> None:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix('.tmp')
        try:
            tmp.write_text(json.dumps(self.data, indent=2))
            tmp.replace(self.path)
        except OSError:
            pass

    def get_daily_limit(self) -> Optional[int]:
        v = self.data.get('daily_limit')
        return v if isinstance(v, int) and v > 0 else None

    def set_daily_limit(self, bytes_val: int) -> None:
        self.data['daily_limit'] = bytes_val
        self.save()

    def remove_daily_limit(self) -> None:
        self.data.pop('daily_limit', None)
        self.save()

    def get_interface(self) -> Optional[str]:
        v = self.data.get('interface')
        return v if isinstance(v, str) and v else None

    def get_retention_days(self) -> int:
        v = self.data.get('retention_days')
        return v if isinstance(v, int) and v > 0 else DEFAULT_RETENTION_DAYS

    def notifications_enabled(self) -> bool:
        return self.data.get('notifications') is not False

    def get_notify_thresholds(self) -> list:
        """Limit percentages that trigger a notification, ascending."""
        v = self.data.get('notify_thresholds')
        if isinstance(v, list):
            clean = sorted({int(x) for x in v
                            if isinstance(x, (int, float)) and not isinstance(x, bool)
                            and 0 < x <= 10000})
            if clean:
                return clean
        return list(DEFAULT_NOTIFY_THRESHOLDS)


# ── Notifications ───────────────────────────────────────────

def notify_available() -> bool:
    return shutil.which('notify-send') is not None


def send_notification(title: str, body: str, urgency: str = 'normal') -> bool:
    """Fire a desktop notification. False if it could not be delivered."""
    try:
        r = subprocess.run(
            ['notify-send', '--app-name=datawall', f'--urgency={urgency}',
             '--icon=network-transmit-receive', title, body],
            capture_output=True, timeout=5)
        return r.returncode == 0
    except (FileNotFoundError, subprocess.TimeoutExpired, OSError):
        return False


def check_limit_alerts(day: dict, limit: Optional[int], thresholds: list,
                       failed: set) -> None:
    """Notify once per threshold per day when usage crosses it.

    Which thresholds already fired is recorded in the day itself, so it
    survives a daemon restart and resets on its own at midnight. A threshold
    is only marked as fired once the notification actually went out, so a
    transient delivery failure (no session bus yet at boot) is retried.
    """
    if not limit or limit <= 0:
        return
    total = day.get('total_sent', 0) + day.get('total_recv', 0)
    if total <= 0:
        return
    pct = total / limit * 100
    fired = day.setdefault('notified', [])
    for t in thresholds:
        if pct < t or t in fired:
            continue
        if t >= 100:
            title = 'datawall: daily limit exceeded'
            urgency = 'critical'
        else:
            title = f'datawall: {t}% of daily limit'
            urgency = 'normal'
        body = f"{format_bytes(total)} of {format_bytes(limit)} ({pct:.0f}%)"
        if send_notification(title, body, urgency):
            fired.append(t)
            failed.discard(t)
            log(f"Notified {t}% threshold ({pct:.0f}% used)")
        elif t not in failed:
            failed.add(t)  # log once, keep retrying quietly
            log(f"Threshold {t}% reached but notification could not be sent")


# ── Daemon ──────────────────────────────────────────────────

def _write_pid():
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    PID_PATH.write_text(str(os.getpid()))


def _remove_pid():
    try:
        PID_PATH.unlink()
    except OSError:
        pass


def daemon_status() -> bool:
    if not PID_PATH.exists():
        return False
    try:
        pid = int(PID_PATH.read_text().strip())
        os.kill(pid, 0)
        return True
    except (OSError, ValueError):
        _remove_pid()
        return False


def daemon_start() -> None:
    if daemon_status():
        print("datawall: daemon is already running")
        return
    print("datawall: starting daemon...")
    sys.stdout.flush()
    pid = os.fork()
    if pid > 0:
        return
    os.setsid()
    pid = os.fork()
    if pid > 0:
        sys.exit(0)
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOG_PATH, 'a') as lf, open(os.devnull, 'r') as null:
        os.dup2(null.fileno(), 0)
        os.dup2(lf.fileno(), 1)
        os.dup2(lf.fileno(), 2)
    _write_pid()
    signal.signal(signal.SIGTERM, lambda *_: _daemon_exit(0))
    log("Daemon started")
    daemon_loop()


def daemon_run() -> None:
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    daemon_loop()


def _daemon_exit(code: int = 0):
    log(f"Daemon stopping (code {code})")
    _remove_pid()
    sys.exit(code)


def daemon_stop() -> None:
    if not PID_PATH.exists():
        print("datawall: daemon is not running")
        return
    try:
        pid = int(PID_PATH.read_text().strip())
        os.kill(pid, signal.SIGTERM)
        for _ in range(10):
            try:
                os.kill(pid, 0)
                time.sleep(0.5)
            except OSError:
                break
        _remove_pid()
        print("datawall: daemon stopped")
    except (OSError, ValueError) as e:
        print(f"datawall: failed to stop daemon: {e}")
        _remove_pid()


def daemon_loop() -> None:
    iface = get_active_interface()
    if not iface:
        log("No active network interface found")
        _daemon_exit(1)
    log(f"Monitoring interface: {iface}")

    store = DataStore()
    cfg = Config()
    retention = cfg.get_retention_days()
    if store.prune(retention):
        log(f"Pruned days older than {retention} days")
        store.save()

    notify_ok = cfg.notifications_enabled() and notify_available()
    if cfg.notifications_enabled() and not notify_ok:
        log("notify-send not found; limit notifications disabled")
    notify_failed = set()

    use_ss = ss_available()
    socket_cache = {}
    # Counter baseline, deliberately daemon-local: a restart re-seeds instead
    # of attributing everything that moved while nothing was watching.
    base = None
    ticks_since_iface_check = 0
    pruned_on = date.today()
    if use_ss:
        log("Using SOCK_DIAG (ss) for exact per-process tracking")

    while True:
        time.sleep(SAMPLE_INTERVAL)
        try:
            # `datawall reset` writes the store from another process; without
            # re-reading it here we would overwrite the reset within 5s
            if store.reload_if_changed():
                log("Store changed on disk, reloaded")
            today = store.get_today()

            if date.today() != pruned_on:
                pruned_on = date.today()
                if store.prune(retention):
                    log(f"Pruned days older than {retention} days")

            ticks_since_iface_check += 1
            if ticks_since_iface_check >= IFACE_RECHECK_EVERY:
                ticks_since_iface_check = 0
                # pick up limit/threshold edits without a restart
                cfg = Config()
                detected = get_active_interface()
                if detected and detected != iface:
                    log(f"Active interface changed: {iface} -> {detected}")
                    iface = detected
                    base = None
                    socket_cache.clear()

            counters = get_interface_counters(iface)
            if counters is None:
                # Interface vanished (unplugged, VPN down, renamed). Re-detect
                # and drop the baseline rather than storing zeros, which the
                # next sample would read back as a huge bogus delta.
                detected = get_active_interface()
                if detected and detected != iface:
                    log(f"Interface {iface} gone, switching to {detected}")
                    iface = detected
                else:
                    log(f"Interface {iface} unavailable, waiting")
                base = None
                socket_cache.clear()
                write_live_state(iface, 0.0, 0.0)
                continue
            cur_tx, cur_rx = counters
            now = time.time()

            if base is None:
                base = (cur_tx, cur_rx, now)
                socket_cache.clear()
                write_live_state(iface, 0.0, 0.0)
                continue

            last_tx, last_rx, last_time = base
            elapsed = now - last_time
            if elapsed > SAMPLE_INTERVAL * 3:
                log(f"Large gap detected ({elapsed:.0f}s), resetting baseline")
                base = (cur_tx, cur_rx, now)
                socket_cache.clear()
                write_live_state(iface, 0.0, 0.0)
                continue

            delta_tx = max(0, cur_tx - last_tx)
            delta_rx = max(0, cur_rx - last_rx)
            interval = max(elapsed, 0.1)
            write_live_state(iface, delta_tx / interval, delta_rx / interval)

            if delta_tx > 0 or delta_rx > 0:
                today['total_sent'] += delta_tx
                today['total_recv'] += delta_rx

                if use_ss:
                    current_ss = sample_sockdiag()
                    seen = set()
                    proc_deltas = {}
                    tracked_tx = 0
                    tracked_rx = 0

                    for pid, fd, name, acked, recv in current_ss:
                        key = (pid, fd)
                        seen.add(key)
                        if key in socket_cache:
                            old_a, old_r = socket_cache[key]
                            if acked >= old_a and recv >= old_r:
                                ds = acked - old_a
                                dr = recv - old_r
                                if ds > 0 or dr > 0:
                                    if pid not in proc_deltas:
                                        proc_deltas[pid] = {'name': name, 'tx': 0, 'rx': 0}
                                    proc_deltas[pid]['tx'] += ds
                                    proc_deltas[pid]['rx'] += dr
                                    tracked_tx += ds
                                    tracked_rx += dr
                        socket_cache[key] = (acked, recv)

                    for k in list(socket_cache):
                        if k not in seen:
                            del socket_cache[k]

                    if tracked_tx > delta_tx and tracked_tx > 0:
                        scale = delta_tx / tracked_tx
                        for data in proc_deltas.values():
                            data['tx'] = int(data['tx'] * scale)
                        tracked_tx = delta_tx

                    if tracked_rx > delta_rx and tracked_rx > 0:
                        scale = delta_rx / tracked_rx
                        for data in proc_deltas.values():
                            data['rx'] = int(data['rx'] * scale)
                        tracked_rx = delta_rx

                    for data in proc_deltas.values():
                        nm = data['name']
                        if nm not in today['processes']:
                            today['processes'][nm] = {'sent': 0, 'recv': 0}
                        today['processes'][nm]['sent'] += data['tx']
                        today['processes'][nm]['recv'] += data['rx']

                    remaining_tx = max(0, delta_tx - tracked_tx)
                    remaining_rx = max(0, delta_rx - tracked_rx)
                    if remaining_tx > 0 or remaining_rx > 0:
                        if UNATTRIBUTED not in today['processes']:
                            today['processes'][UNATTRIBUTED] = {'sent': 0, 'recv': 0}
                        today['processes'][UNATTRIBUTED]['sent'] += remaining_tx
                        today['processes'][UNATTRIBUTED]['recv'] += remaining_rx
                else:
                    active = get_process_connections()
                    total_conns = sum(p['connections'] for p in active.values())
                    if total_conns > 0:
                        for info in active.values():
                            w = info['connections'] / total_conns
                            nm = info['name']
                            if nm not in today['processes']:
                                today['processes'][nm] = {'sent': 0, 'recv': 0}
                            today['processes'][nm]['sent'] += int(delta_tx * w)
                            today['processes'][nm]['recv'] += int(delta_rx * w)
                    else:
                        if UNATTRIBUTED not in today['processes']:
                            today['processes'][UNATTRIBUTED] = {'sent': 0, 'recv': 0}
                        today['processes'][UNATTRIBUTED]['sent'] += delta_tx
                        today['processes'][UNATTRIBUTED]['recv'] += delta_rx

            if notify_ok:
                check_limit_alerts(today, cfg.get_daily_limit(),
                                   cfg.get_notify_thresholds(), notify_failed)

            base = (cur_tx, cur_rx, now)
            store.save()
        except (OSError, KeyError, TypeError, ValueError) as e:
            log(f"Loop error: {e}")
            time.sleep(5)


